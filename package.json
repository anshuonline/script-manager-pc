{
  "name": "script-manager",
  "version": "1.15.0",
  "description": "A premium dark-mode app to organize video scripts, thumbnails, and schedule publish dates.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "dev": "electron ."
  },
  "author": "Script Manager",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.scriptmanager.app",
    "productName": "Script Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "app.js",
      "context-menu.js",
      "sync-server.js",
      "icon1.ico",
      "logo.png",
      "components/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon1.ico"
    },
    "asar": false,
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "googleapis": "^174.0.1",
    "jszip": "^3.10.1"
  }
}
